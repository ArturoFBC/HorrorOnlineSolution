@model UserAddRequest
@{
	ViewBag.Title = "Crear cuenta";
}


<form asp-controller="Account" asp-action="Register" method="post" >
		<h1>Crear cuenta</h1>

	<div class="form-field">
			<label asp-for="UserName"></label>
			<input asp-for="UserName"/>
		</div>
		<span class="val-error" asp-validation-for="UserName"></span>

	<div class="form-field">
			<label asp-for="Email"></label>
			<input asp-for="Email"/>
		</div>
		<span class="val-error" asp-validation-for="Email"></span>

	<div class="form-field">
			<label asp-for="Password"></label>
			<input asp-for="Password"/>
		</div>
		<span class="val-error" asp-validation-for="Password"></span>

	<div class="form-field">
			<label asp-for="ConfirmPassword"></label>
			<input asp-for="ConfirmPassword"/>
		</div>
		<span class="val-error" asp-validation-for="ConfirmPassword"></span>

		<button type="submit" class="base-font text-white text-button">Registrar usuario</button>
		<div asp-validation-summary="All"></div>

		@if (ViewBag.Error is not null)
		{
			<div class="text-red">
				<ul>
					@foreach (string error in ViewBag.Errors)
					{
						<li >@error</li>
					}
				</ul>
			</div>
		}
</form>
